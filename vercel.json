{
  "buildCommand": "echo 'Deploying static portal'",
  "outputDirectory": "static",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/downloads/:match*", "destination": "/downloads/:match*" },
    { "source": "/assets/:match*", "destination": "/assets/:match*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
